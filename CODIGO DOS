.MODEL SMALL
.STACK 100H

.DATA
    msg1 DB 'ENTER DATA (00-FF): $'
    msg2 DB 13,10,'ENTER MASK (00-FF): $'
    msg3 DB 13,10,'SELECT OPERATION (A=AND, O=OR, X=XOR): $'
    msg4 DB 13,10,'BINARY RESULT: $'
    msg5 DB 13,10,'INVALID OPERATION.$'

    data_value DB ?
    mask_value DB ?
    result_value DB ?

.CODE

MAIN PROC
    MOV AX, @DATA
    MOV DS, AX

    LEA DX, msg1
    MOV AH, 09H
    INT 21H

    CALL READ_HEX_BYTE
    MOV data_value, AL

    LEA DX, msg2
    MOV AH, 09H
    INT 21H

    CALL READ_HEX_BYTE
    MOV mask_value, AL

    LEA DX, msg3
    MOV AH, 09H
    INT 21H

    MOV AH, 01H
    INT 21H

    CMP AL, 'a'
    JB CHECK_OPERATION

    CMP AL, 'z'
    JA CHECK_OPERATION

    SUB AL, 20H

CHECK_OPERATION:
    CMP AL, 'A'
    JE OP_AND

    CMP AL, 'O'
    JE OP_OR

    CMP AL, 'X'
    JE OP_XOR

    LEA DX, msg5
    MOV AH, 09H
    INT 21H

    JMP FINISH

OP_AND:
    MOV AL, data_value
    MOV BL, mask_value

    AND AL, BL

    MOV result_value, AL
    JMP DISPLAY_RESULT

OP_OR:
    MOV AL, data_value
    MOV BL, mask_value

    OR AL, BL

    MOV result_value, AL
    JMP DISPLAY_RESULT

OP_XOR:
    MOV AL, data_value
    MOV BL, mask_value

    XOR AL, BL

    MOV result_value, AL

DISPLAY_RESULT:
    LEA DX, msg4
    MOV AH, 09H
    INT 21H

    MOV AL, result_value
    CALL PRINT_BINARY

FINISH:
    MOV AX, 4C00H
    INT 21H

MAIN ENDP

READ_HEX_BYTE PROC
    CALL READ_HEX_DIGIT
    MOV BL, AL
    SHL BL, 4

    CALL READ_HEX_DIGIT
    OR AL, BL

    RET
READ_HEX_BYTE ENDP

READ_HEX_DIGIT PROC

READ_AGAIN:
    MOV AH, 01H
    INT 21H

    CMP AL, '0'
    JB READ_AGAIN

    CMP AL, '9'
    JBE NUMERIC_DIGIT

    CMP AL, 'A'
    JB CHECK_LOWERCASE

    CMP AL, 'F'
    JBE UPPERCASE_DIGIT

CHECK_LOWERCASE:
    CMP AL, 'a'
    JB READ_AGAIN

    CMP AL, 'f'
    JA READ_AGAIN

    SUB AL, 20H

UPPERCASE_DIGIT:
    SUB AL, 'A'-10
    RET

NUMERIC_DIGIT:
    SUB AL, '0'
    RET

READ_HEX_DIGIT ENDP

PRINT_BINARY PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX

    MOV BL, AL
    MOV CX, 8

BINARY_LOOP:
    SHL BL, 1

    MOV DL, '0'
    JNC DISPLAY_BIT

    MOV DL, '1'

DISPLAY_BIT:
    MOV AH, 02H
    INT 21H

    LOOP BINARY_LOOP

    POP DX
    POP CX
    POP BX
    POP AX

    RET

PRINT_BINARY ENDP

END MAIN
