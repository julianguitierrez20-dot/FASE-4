Primer código 1 
.MODEL SMALL
.STACK 100H

.DATA
    msg1 DB 'FIRST HEX VALUE (00-FF): $'
    msg2 DB 13,10,'SECOND HEX VALUE (00-FF): $'
    msg3 DB 13,10,'OPERATION (+ OR -): $'
    msg4 DB 13,10,'RESULT: $'
    msg5 DB 13,10,'INVALID OPERATION.$'
    value1 DB ?
    value2 DB ?

.CODE
MAIN PROC
    MOV AX, @DATA
    MOV DS, AX

    LEA DX, msg1
    MOV AH, 09H
    INT 21H

    CALL READ_HEX_BYTE
    MOV value1, AL

    LEA DX, msg2
    MOV AH, 09H
    INT 21H

    CALL READ_HEX_BYTE
    MOV value2, AL

    LEA DX, msg3
    MOV AH, 09H
    INT 21H

    MOV AH, 01H
    INT 21H

    CMP AL, '+'
    JE ADDITION

    CMP AL, '-'
    JE SUBTRACTION

    LEA DX, msg5
    MOV AH, 09H
    INT 21H
    JMP FINISH

ADDITION:
    LEA DX, msg4
    MOV AH, 09H
    INT 21H

    MOV AL, value1
    MOV AH, 00H
    MOV BL, value2
    MOV BH, 00H

    ADD AX, BX

    CALL PRINT_HEX16
    JMP FINISH

SUBTRACTION:
    LEA DX, msg4
    MOV AH, 09H
    INT 21H

    MOV AL, value1
    MOV AH, 00H
    MOV BL, value2
    MOV BH, 00H

    SUB AX, BX
    JNC POSITIVE_RESULT

    NEG AX
    PUSH AX

    MOV DL, '-'
    MOV AH, 02H
    INT 21H

    POP AX

POSITIVE_RESULT:
    CALL PRINT_HEX16

FINISH:
    MOV AX, 4C00H
    INT 21H

MAIN ENDP

READ_HEX_BYTE PROC
    CALL READ_HEX_DIGIT
    MOV BL, AL
    SHL BL, 4

    CALL READ_HEX_DIGIT
    OR AL, BL

    RET
READ_HEX_BYTE ENDP

READ_HEX_DIGIT PROC

READ_AGAIN:
    MOV AH, 01H
    INT 21H

    CMP AL, '0'
    JB READ_AGAIN

    CMP AL, '9'
    JBE NUMERIC_DIGIT

    CMP AL, 'A'
    JB CHECK_LOWERCASE

    CMP AL, 'F'
    JBE UPPERCASE_DIGIT

CHECK_LOWERCASE:
    CMP AL, 'a'
    JB READ_AGAIN

    CMP AL, 'f'
    JA READ_AGAIN

    SUB AL, 20H

UPPERCASE_DIGIT:
    SUB AL, 'A'-10
    RET

NUMERIC_DIGIT:
    SUB AL, '0'
    RET

READ_HEX_DIGIT ENDP

PRINT_HEX16 PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX

    MOV BX, AX
    MOV CX, 4

PRINT_LOOP:
    MOV DL, BH
    SHR DL, 4

    SHL BX, 4

    CMP DL, 9
    JBE NUMBER_CHAR

    ADD DL, 7

NUMBER_CHAR:
    ADD DL, '0'

    MOV AH, 02H
    INT 21H

    LOOP PRINT_LOOP

    POP DX
    POP CX
    POP BX
    POP AX

    RET
PRINT_HEX16 ENDP

END MAIN
