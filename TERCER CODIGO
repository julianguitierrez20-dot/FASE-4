.MODEL SMALL
.STACK 100H

.DATA
    msg1 DB 'PROGRESSIVE HEXADECIMAL COUNTER',13,10,'$'
    msg2 DB 'COUNTING FROM 0 TO F:',13,10,'$'
    msg3 DB 13,10,'COUNTER FINISHED.$'

.CODE

MAIN PROC

    MOV AX, @DATA
    MOV DS, AX

    LEA DX, msg1
    MOV AH, 09H
    INT 21H

    LEA DX, msg2
    MOV AH, 09H
    INT 21H

    MOV BL, 00H
    MOV CX, 16

COUNTER_LOOP:

    MOV DL, BL

    CMP DL, 9
    JBE NUMERIC_VALUE

    ADD DL, 7

NUMERIC_VALUE:
    ADD DL, '0'

    MOV AH, 02H
    INT 21H

    MOV DL, ' '
    MOV AH, 02H
    INT 21H

    INC BL

    LOOP COUNTER_LOOP

    LEA DX, msg3
    MOV AH, 09H
    INT 21H

    MOV AX, 4C00H
    INT 21H

MAIN ENDP

END MAIN
